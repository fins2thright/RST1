{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Server (index.js)",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "env": {
        "DB_CONNECTION": "${env:DB_CONNECTION}"
      }
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Node",
      "processId": "${command:PickProcess}",
      "restart": true
    }
  ]
}
