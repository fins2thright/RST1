# Environment Variables for RST1 Server

# Google Custom Search API Configuration
# IMPORTANT: Replace these with your actual credentials from:
# - API Key: https://console.cloud.google.com/apis/credentials
# - Search Engine ID: https://programmablesearchengine.google.com/

# Paste your Google API key here:
GOOGLE_API_KEY=

# Paste your Search Engine ID here:
GOOGLE_SEARCH_ENGINE_ID=

# Database connection (for other features)
DB_CONNECTION=Server=(localdb)\\MSSQLLocalDB;Database=RSTdb1;Trusted_Connection=True;
